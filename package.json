{
  "name": "live-translate",
  "version": "2.1.0",
  "description": "Live multilingual event translator: speak in one language, show many on screen and on every phone.",
  "type": "module",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "demo": "node server/index.js --open",
    "desktop": "electron .",
    "dist": "electron-builder --win --x64 --publish never --config electron-builder.config.cjs",
    "test": "node --test",
    "test:mic": "node scripts/mic-e2e.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "sherpa-onnx-node": "1.13.8",
    "tar-stream": "3.1.7",
    "unbzip2-stream": "1.4.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "png-to-ico": "3.0.2",
    "resedit": "3.1.0"
  },
  "productName": "Live Translate",
  "author": "Live Translate"
}
